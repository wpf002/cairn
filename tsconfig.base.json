{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@cairn/stages": [
        "./packages/stages/src/index.ts"
      ],
      "@cairn/framework": [
        "./packages/framework/src/index.ts"
      ],
      "@cairn/canon": [
        "./packages/canon/src/index.ts"
      ],
      "@cairn/substrate": [
        "./packages/substrate/src/index.ts"
      ],
      "@cairn/escalation": [
        "./packages/escalation/src/index.ts"
      ],
      "@cairn/crypto": [
        "./packages/crypto/src/index.ts"
      ],
      "@cairn/db": [
        "./packages/db/src/index.ts"
      ],
      "@cairn/ai": [
        "./packages/ai/src/index.ts"
      ],
      "@cairn/trackers": [
        "./packages/trackers/src/index.ts"
      ],
      "@cairn/dashboard": [
        "./packages/dashboard/src/index.ts"
      ],
      "@cairn/journey": [
        "./packages/journey/src/index.ts"
      ],
      "@cairn/monetization": [
        "./packages/monetization/src/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}