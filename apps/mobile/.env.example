# Copy to .env (gitignored) and fill in. EXPO_PUBLIC_* vars are compiled into
# the app bundle — only public-by-design values belong here. Secrets (the
# Anthropic API key, Supabase service_role key) must NEVER appear in this file;
# they live on the backend proxy / server only.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Cairn's Edge Function that holds the Anthropic API key (Phase 5 ASK).
# The key itself goes in supabase/functions/.env — NEVER here, because
# everything in this file is compiled into the shipped app bundle.
# Leave empty to run without the AI assistant.
EXPO_PUBLIC_AI_PROXY_URL=

# RevenueCat → Project → API keys → public SDK key (safe to embed)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
