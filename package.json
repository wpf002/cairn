{
  "name": "cairn",
  "private": true,
  "version": "0.0.0",
  "description": "Christian family formation platform — conception through age 21",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "validate:substrate": "tsx packages/substrate/src/cli/validate.ts",
    "ci": "pnpm typecheck && pnpm test && pnpm validate:substrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
